@model List<RaceDay.Web.Models.EventModel>

@{
    ViewData["Title"] = "Events";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Race Events</h2>

        @if (Context.Session.GetString("Role") == "Organiser")
        {
            <a asp-action="Create" class="btn btn-primary">Create Event</a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">No events are currently available.</div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">

                        <!-- Event image -->
                        <img src="@Url.Action("Image", "Events", new { id = item.Id })"
                             class="card-img-top"
                             alt="@item.Name"
                             style="height: 220px; object-fit: cover;"
                             onerror="this.style.display='none';" />

                        <div class="card-body">
                            <h5 class="card-title">@item.Name</h5>

                            <p class="card-text">@item.Description</p>

                            <p><strong>Date:</strong> @item.EventDate.ToString("dd MMM yyyy")</p>
                            <p><strong>Location:</strong> @item.Location</p>
                            <p><strong>Distance:</strong> @item.DistanceKm km</p>
                            <p><strong>Type:</strong> @item.EventType</p>
                            <p><strong>Organiser:</strong> @item.Organiser</p>

                            <a asp-controller="Categories"
                               asp-action="Index"
                               asp-route-eventId="@item.Id"
                               class="btn btn-outline-primary btn-sm">
                                View Categories
                            </a>

                            @if (Context.Session.GetString("Role") == "Participant")
                            {
                                <a asp-controller="Enrollments"
                                   asp-action="Create"
                                   asp-route-eventId="@item.Id"
                                   class="btn btn-success btn-sm">
                                    Enroll
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
