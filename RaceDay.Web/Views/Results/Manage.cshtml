@model List<RaceDay.Web.Models.EventResultManagementModel>

@{
    ViewData["Title"] = "Manage Results";

    var events = ViewBag.Events as List<RaceDay.Web.Models.EventModel>
                 ?? new List<RaceDay.Web.Models.EventModel>();

    int? selectedEventId = ViewBag.SelectedEventId as int?;
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Results Management</h1>
            <p class="text-muted">
                Record and manage participant race results.
            </p>
        </div>

        <a asp-controller="Organiser"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h5 class="card-title">Select Event</h5>

            @if (!events.Any())
            {
                <div class="alert alert-info mb-0">
                    You do not have any events yet.
                    Create an event before managing results.
                </div>
            }
            else
            {
                <form asp-controller="Results"
                      asp-action="Manage"
                      method="get">

                    <div class="row align-items-end">

                        <div class="col-md-8">
                            <label class="form-label">
                                Choose an event
                            </label>

                            <select name="eventId"
                                    class="form-select"
                                    required>

                                <option value="">
                                    -- Select an event --
                                </option>

                                @foreach (var raceEvent in events)
                                {
                                    <option value="@raceEvent.Id"
                                            selected="@(selectedEventId == raceEvent.Id)">
                                        @raceEvent.Name
                                    </option>
                                }

                            </select>
                        </div>

                        <div class="col-md-4">
                            <button type="submit"
                                    class="btn btn-primary w-100">
                                View Participants
                            </button>
                        </div>

                    </div>
                </form>
            }

        </div>
    </div>

    @if (selectedEventId.HasValue)
    {
        <div class="card shadow-sm">

            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Event Participants and Results</h5>
            </div>

            <div class="card-body">

                @if (!Model.Any())
                {
                    <div class="alert alert-info mb-0">
                        No participants have enrolled in this event yet.
                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-striped table-hover align-middle">

                            <thead>
                                <tr>
                                    <th>Participant</th>
                                    <th>Category</th>
                                    <th>Finish Time</th>
                                    <th>Position</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var participant in Model)
                                {
                                    <tr>
                                        <td>
                                            @participant.ParticipantName
                                        </td>

                                        <td>
                                            @participant.CategoryName
                                        </td>

                                        <td>
                                            @if (participant.HasResult)
                                            {
                                                @participant.FinishTime?.ToString(@"hh\:mm\:ss")
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    Not recorded
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            @if (participant.HasResult)
                                            {
                                                @participant.Position
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>

                                        <td>
                                            @if (participant.HasResult)
                                            {
                                                <span class="badge bg-success">
                                                    Recorded
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    Pending
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            @if (participant.HasResult)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-primary"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#updateResult@(participant.ResultId)">
                                                    Edit Result
                                                </button>

                                                <div class="modal fade"
                                                     id="updateResult@(participant.ResultId)"
                                                     tabindex="-1"
                                                     aria-hidden="true">

                                                    <div class="modal-dialog">
                                                        <div class="modal-content">

                                                            <form asp-controller="Results"
                                                                  asp-action="Update"
                                                                  method="post">

                                                                @Html.AntiForgeryToken()

                                                                <div class="modal-header">
                                                                    <h5 class="modal-title">
                                                                        Update Result
                                                                    </h5>

                                                                    <button type="button"
                                                                            class="btn-close"
                                                                            data-bs-dismiss="modal">
                                                                    </button>
                                                                </div>

                                                                <div class="modal-body">

                                                                    <input type="hidden"
                                                                           name="ResultId"
                                                                           value="@participant.ResultId" />

                                                                    <input type="hidden"
                                                                           name="EventId"
                                                                           value="@selectedEventId" />

                                                                    <div class="mb-3">
                                                                        <label class="form-label">
                                                                            Participant
                                                                        </label>

                                                                        <input class="form-control"
                                                                               value="@participant.ParticipantName"
                                                                               readonly />
                                                                    </div>

                                                                    <div class="mb-3">
                                                                        <label class="form-label">
                                                                            Finish Time
                                                                        </label>

                                                                        <input type="text"
                                                                               name="FinishTime"
                                                                               class="form-control"
                                                                               value="@participant.FinishTime?.ToString(@"hh\:mm\:ss")"
                                                                               placeholder="00:45:30"
                                                                               required />
                                                                    </div>

                                                                    <div class="mb-3">
                                                                        <label class="form-label">
                                                                            Position
                                                                        </label>

                                                                        <input type="number"
                                                                               name="Position"
                                                                               class="form-control"
                                                                               min="1"
                                                                               value="@participant.Position"
                                                                               required />
                                                                    </div>

                                                                </div>

                                                                <div class="modal-footer">

                                                                    <button type="button"
                                                                            class="btn btn-secondary"
                                                                            data-bs-dismiss="modal">
                                                                        Cancel
                                                                    </button>

                                                                    <button type="submit"
                                                                            class="btn btn-primary">
                                                                        Update Result
                                                                    </button>

                                                                </div>

                                                            </form>

                                                        </div>
                                                    </div>

                                                </div>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-success"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#createResult@(participant.Id)">
                                                    Record Result
                                                </button>

                                                <div class="modal fade"
                                                     id="createResult@(participant.Id)"
                                                     tabindex="-1"
                                                     aria-hidden="true">

                                                    <div class="modal-dialog">
                                                        <div class="modal-content">

                                                            <form asp-controller="Results"
                                                                  asp-action="Create"
                                                                  method="post">

                                                                @Html.AntiForgeryToken()

                                                                <div class="modal-header">
                                                                    <h5 class="modal-title">
                                                                        Record Result
                                                                    </h5>

                                                                    <button type="button"
                                                                            class="btn-close"
                                                                            data-bs-dismiss="modal">
                                                                    </button>
                                                                </div>

                                                                <div class="modal-body">

                                                                    <input type="hidden"
                                                                           name="eventId"
                                                                           value="@selectedEventId" />

                                                                    <input type="hidden"
                                                                           name="EnrollmentId"
                                                                           value="@participant.Id" />

                                                                    <div class="mb-3">
                                                                        <label class="form-label">
                                                                            Participant
                                                                        </label>

                                                                        <input class="form-control"
                                                                               value="@participant.ParticipantName"
                                                                               readonly />
                                                                    </div>

                                                                    <div class="mb-3">
                                                                        <label class="form-label">
                                                                            Finish Time
                                                                        </label>

                                                                        <input type="text"
                                                                               name="FinishTime"
                                                                               class="form-control"
                                                                               placeholder="00:45:30"
                                                                               required />
                                                                        <small class="text-muted">
                                                                            Format: HH:mm:ss
                                                                        </small>
                                                                    </div>

                                                                    <div class="mb-3">
                                                                        <label class="form-label">
                                                                            Position
                                                                        </label>

                                                                        <input type="number"
                                                                               name="Position"
                                                                               class="form-control"
                                                                               min="1"
                                                                               required />
                                                                    </div>

                                                                </div>

                                                                <div class="modal-footer">

                                                                    <button type="button"
                                                                            class="btn btn-secondary"
                                                                            data-bs-dismiss="modal">
                                                                        Cancel
                                                                    </button>

                                                                    <button type="submit"
                                                                            class="btn btn-success">
                                                                        Save Result
                                                                    </button>

                                                                </div>

                                                            </form>

                                                        </div>
                                                    </div>

                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>
        </div>
    }

</div>
